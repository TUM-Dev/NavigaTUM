		"@types/geojson": "7946.0.16",
		"@vue/tsconfig": "0.9.1",
		"openapi-typescript": "7.13.0",
		"tailwindcss": "4.3.4",
		"typescript": "7.0.2",
		"vitest": "5.1.0",
		"vue-tsc": "3.3.14"
	},
