		"@mdi/js": "^7.4.47",
		"@nuxt/content": "3.16.2",
		"@nuxt/image": "2.2.1",
		"@nuxtjs/color-mode": "4.1.0",
		"@vueuse/core": "15.0.0",
		"@vueuse/nuxt": "15.0.0",
		"@vueuse/router": "15.0.0",
		"better-sqlite3": "13.0.3",
		"maplibre-gl": "6.16.0",
		"nuxt": "4.6.4",
		"opening_hours": "^3.13.0",
		"prom-client": "^15.1.3",
		"sharp": "0.35.5",
		"temporal-polyfill": "1.0.8",
		"ts-essentials": "^10.1.1",
		"vue": "3.5.45",
